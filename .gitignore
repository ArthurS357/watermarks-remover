# Deny by default: only what is explicitly allowed below can be added to git.
# Local test artifacts, secrets (.env), and tooling stay out without a rule
# for each one. Tracked files are unaffected.
/*
!/.github/
!/.github/**
!/benchmarks/
!/benchmarks/**
!/docs/
!/docs/**
!/integrations/
!/integrations/**
!/service/
!/service/**
# git cannot re-include a file whose parent dir is excluded: re-open /skills
# itself, then deny its children again before allowing each skill.
!/skills/
/skills/*
!/skills/clean-user-facing-text/
!/skills/clean-user-facing-text/**
!/skills/remove-ai-marks/
!/skills/remove-ai-marks/**
!/tests/
!/tests/**
!/.coderabbit.yaml
!/.coveragerc
!/.dockerignore
!/.env.example
!/.gitattributes
!/.gitignore
!/.pre-commit-hooks.yaml
!/AI_INTEGRATION.md
!/CODE_OF_CONDUCT.md
!/compose-check.sh
!/compose.yaml
!/CONTRIBUTING.md
!/install-skill.sh
!/install_skill.py
!/LICENSE
!/Makefile
!/pytest.ini
!/README.md
!/requirements-dev.txt
!/ruff.toml
!/SECURITY.md
!/start-watermarks-server.ps1
!/watermarks-server.cmd

# Exceptions even inside allowed trees
.env
**/__pycache__/
*.pyc
.venv/
.firecrawl/
.figlet/
posts.md
*.cleaned.*
*.bak
