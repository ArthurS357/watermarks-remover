# Copy to .env for `docker compose` (docker compose auto-loads .env from the
# repo root). Everything here is optional — the core service works with no
# configuration at all.

# ---------------------------------------------------------------------------
# Core HTTP service (used by wr-core)
# ---------------------------------------------------------------------------
# Optional bearer token for the HTTP API. When set, every request except
# /health and /readyz must send `Authorization: Bearer <key>`.
WATERMARKS_SERVER_API_KEY=

# server.py refuses a non-loopback bind with no API key set. compose.yaml
# defaults this to 1 for wr-core because its actual access boundary is the
# host port mapping (127.0.0.1:8765:8765), not the bind host inside the
# container. Set to an empty value here to require an API key even under
# compose, e.g. if you republish the port on a non-loopback interface.
# WATERMARKS_SERVER_ALLOW_INSECURE_BIND=1

# Bind address and port. server.py refuses a non-loopback host with no API
# key set (see the flag above). Under compose these are left at the
# defaults; the host port mapping is the access boundary.
# WATERMARKS_SERVER_HOST=127.0.0.1
# WATERMARKS_SERVER_PORT=8765

# Throughput and resource ceilings. Each in-flight POST holds several
# copies of its payload in memory, so raise the concurrency limit and the
# container mem_limit together. A malformed or out-of-range value here is
# reported on stderr and the default is used instead of aborting startup.
# WATERMARKS_MAX_CONCURRENT_REQUESTS=4    # minimum 1; 0 would 503 every POST
# WATERMARKS_SERVER_REQUEST_TIMEOUT=30    # seconds a connection may idle
# WATERMARKS_MAX_BATCH_FILES=50           # files per /*/batch request

# Hard caps on a single input. Shared by the CLIs and the service; the
# HTTP body cap is 1.5x MAX_INPUT_BYTES to cover base64 overhead.
# WATERMARKS_MAX_INPUT_BYTES=268435456    # 256 MiB
# WATERMARKS_MAX_STDIN_BYTES=67108864     # 64 MiB

# ---------------------------------------------------------------------------
# Vendor text-watermark detection (wr-core)
# ---------------------------------------------------------------------------
# (Retired Aug 2026) Google removed SynthID text watermarking from the
# Generative Language API; the gemini-synthid-text detector was removed.
# A vendor detector can be re-added here if Google exposes detection again.

# Optional MarkLLM research harness (host checkouts only; not in the core
# image). Same-config-only detection — not a vendor oracle.
# MARKLLM_DIR=~/MarkLLM
# WATERMARKS_MARKLLM_SCHEME=kgw           # kgw | synthid

# ---------------------------------------------------------------------------
# Harness / heavy backends (only used by the harness/heavy profiles)
# ---------------------------------------------------------------------------
# Optional Hugging Face token for gated models (CtrlRegen, MarkLLM,
# MarkDiffusion score models). Env only — never on argv.
HF_TOKEN=

# SynthID image scoring over HTTP (heavy profile): point wr-core at the
# wr-synthid-score sidecar and share the same bearer key on both sides.
# With the heavy profile up, uncomment:
# WATERMARKS_SYNTHID_SCORER_URL=http://wr-synthid-score:8766
# WATERMARKS_SYNTHID_SCORER_API_KEY=
# WATERMARKS_SYNTHID_SCORER_TIMEOUT=60

# ---------------------------------------------------------------------------
# Client-side (used by the skill or curl, NOT by compose)
# ---------------------------------------------------------------------------
# Where to reach the service. Defaults to http://127.0.0.1:8765.
# WATERMARKS_SERVICE_URL=http://127.0.0.1:8765

# ---------------------------------------------------------------------------
# Layer B statistical-watermark rewrite (only for the rewrite_text.py hook,
# which runs inside the core image or a local checkout; the agent skill does
# Layer B itself with its own model and does not need these)
# ---------------------------------------------------------------------------
# WATERMARKS_REWRITE_BACKEND=ollama        # or: openai-compatible
# WATERMARKS_REWRITE_MODEL=llama3.2
# WATERMARKS_REWRITE_BASE_URL=http://127.0.0.1:11434
# WATERMARKS_REWRITE_API_KEY=              # env only, never on argv
# WATERMARKS_REWRITE_ALLOW_REMOTE=1        # only for non-loopback endpoints
# WATERMARKS_REWRITE_REASONING_EFFORT=none # none/low/medium/high, or off to omit
# WATERMARKS_REWRITE_CANDIDATES=1          # variants generated per evaluation round (default 1)
# WATERMARKS_REWRITE_LOOPS=1               # max evaluation rounds; retries new variants until one passes (default 1)
# WATERMARKS_REWRITE_MAX_RESPONSE_BYTES=67108864  # 64 MiB cap on a single backend response

# ---------------------------------------------------------------------------
# Advanced / internal (research harness checkouts, resource ceilings for
# child processes, sidecar bind config). Rarely need to change; defaults
# are sane for a single-host dev setup.
# ---------------------------------------------------------------------------
# Upstream research checkouts (host only; not bundled). Presence of the DIR
# var is what `/capabilities` reports as available for that backend.
# NOAI_WATERMARK_DIR=~/noai-watermark        # CtrlRegen pixel-removal backend
# REVERSE_SYNTHID_DIR=~/reverse-synthid      # SynthID image scorer (score_synthid.py)
# MARKDIFFUSION_DIR=~/MarkDiffusion          # image watermark research harness
# MARKDIFFUSION_MODEL=huanzi05/stable-diffusion-2-1-base  # image harness diffusion model
# MARKDIFFUSION_MODEL_REVISION=              # HF Hub commit/tag for MARKDIFFUSION_MODEL (unset: pinned SHA for the default model, main otherwise)
# MARKLLM_MODEL=facebook/opt-1.3b            # text watermark scoring model
# MARKLLM_MODEL_REVISION=                    # HF Hub commit/tag for MARKLLM_MODEL (unset: pinned SHA for the default model, main otherwise)
# WATERMARKS_MARKLLM_PORT=                   # port for the persistent MarkLLM detector subprocess
# WATERMARKS_MARKLLM_TIMEOUT=180.0           # seconds rewrite_text.py waits on a MarkLLM round-trip
# WATERMARKS_GUMBEL_KEY=                     # hex key for the Gumbel/Aaronson text-watermark detector

# Resource ceilings (bytes) applied to spawned child processes via
# resource.setrlimit on POSIX; no-op on Windows. Defaults are generous.
# WATERMARKS_CHILD_RLIMIT_AS=4294967296       # 4 GiB, generic child processes
# WATERMARKS_CHILD_RLIMIT_FSIZE=2147483648    # 2 GiB, generic child processes
# WATERMARKS_CTRLREGEN_RLIMIT_AS=34359738368  # 32 GiB, CtrlRegen (loads diffusion + LLM weights)
# WATERMARKS_CTRLREGEN_RLIMIT_FSIZE=2147483648
# WATERMARKS_MARKLLM_RLIMIT_AS=4294967296     # 4 GiB, the MarkLLM detector subprocess

# wr-synthid-score sidecar's own bind config (distinct from the
# WATERMARKS_SYNTHID_SCORER_* client vars above, which is how wr-core reaches it).
# WATERMARKS_SYNTHID_MODEL=                   # model override for the sidecar's scorer
# WATERMARKS_SYNTHID_SERVER_HOST=127.0.0.1
# WATERMARKS_SYNTHID_SERVER_PORT=8766
# WATERMARKS_SYNTHID_SERVER_VERSION=dev       # version string reported by its /health
# WATERMARKS_SYNTHID_SERVER_ALLOW_INSECURE_BIND=1  # same rationale as WATERMARKS_SERVER_ALLOW_INSECURE_BIND

# Version string reported by the core service's /health (default: dev).
# WATERMARKS_SERVER_VERSION=dev
